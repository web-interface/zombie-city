{
  "_설명": {
    "파일": "data/skills.json",
    "하는 일": "스킬 버튼으로 쓰는 스킬. 스킬 하나 = 다시 쓰기 시간 + 효과 조각 목록(기절·밀기·회복·돌진·빛·불 장판 …). 전직은 이 조각의 숫자를 바꾸거나 조각을 더하거나 스킬을 통째로 바꾼다. is_hidden = 히든 스킬(생존자마다 하나, 금색 카드로 아주 가끔 — 전직이 바꾼 스킬보다 우선).",
    "쓰는 곳": "scripts/skills/skill_runner.gd 가 효과 조각을 차례로 실행한다. scripts/ui/skill_button.gd 가 아이콘과 다시 쓰기 시간을 보여 준다.",
    "근거 문서": "03 §1 생존자 스킬, 03 §1-2 전직, 03 §4-1 히든 스킬, 14 §2-5"
  },
  "_효과_조각_종류": {
    "radial_stun": "반경 안 좀비 기절 (radius, seconds, damage)",
    "radial_push": "반경 안 좀비를 바깥으로 밀기 (radius, push_distance, damage)",
    "cone_push": "바라보는 쪽 부채꼴 좀비 밀고 느리게 (angle_degrees, range, push_distance, slow_ratio, slow_seconds, damage, 소리 sound·알갱이 색 color 는 고를 수 있음)",
    "light_burst": "그 자리를 잠깐 밝힘 — 빛과 어둠 (radius, seconds)",
    "dash": "돌진 (seconds, speed_multiplier, contact_damage, knockback, invulnerable)",
    "heal": "최대 체력의 비율만큼 회복 (ratio)",
    "guard": "잠깐 받는 피해 줄이기 (seconds, damage_taken_multiplier)",
    "line_shot": "바라보는 쪽으로 화면 끝까지 꿰뚫는 한 발 (damage, width)",
    "fire_zone": "생존자 주변 불 장판 (radius, seconds, damage_per_second)",
    "poison_burst": "주변 좀비에 독 (radius, damage_per_second, seconds)",
    "collect_all_shards": "화면의 백신 조각을 모두 끌어옴",
    "airstrike": "히든: 예고 원 뒤 폭격 (strikes 발을 seconds 동안, search_radius 안 좀비 쪽, 반경 radius·피해 damage)",
    "backdraft": "히든: 몸에서 화염 고리 rings 번(ring_gap_seconds 간격, 반경 radius_start + radius_step × 번째, 피해 damage·밀기 push_distance) + 큰 불 장판(fire_radius·fire_seconds·fire_damage_per_second)",
    "express": "히든: 무적 돌진 dashes 번(dash_seconds·gap_seconds·speed_multiplier, 부딪힘 contact_damage·knockback), 지나간 길에 blast_gap_seconds 마다 폭발(blast_radius·blast_damage)",
    "stat_boost": "seconds 동안 능력치 바꾸기(multiply), 끝나면 after_seconds 동안 after_multiply (카페인 충전 — scripts/skills/trait_effects.gd)",
    "clock_out": "히든: seconds 동안 화면 좀비가 멈춤(보스는 boss_seconds) + 내 피해 damage_multiplier 배 (칼퇴근)",
    "miracle": "히든: 체력 heal_ratio 회복 + invulnerable_seconds 무적 + 주변 독(poison_radius·poison_damage_per_second·poison_seconds) — 기적의 처방",
    "grand_slam": "히든: 거대한 공 balls 개가 몸에서 사방으로 화면을 가로지름 (speed·distance·radius, 닿으면 damage·knockback)",
    "pack_hunt": "사냥개 dogs 마리가 seconds 동안 가까운 좀비를 쫓아다니며 문다 (speed·bite_radius·damage·bite_interval_seconds) — 히든 '사냥개 무리', 조련사 전직은 작게"
  },
