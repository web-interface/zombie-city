      "skill_changes": [
        { "change": "scale_effect", "effect": "radial_stun", "field": "radius", "by": 1.4 },
        { "change": "scale_effect", "effect": "light_burst", "field": "radius", "by": 1.4 },
        { "change": "add_to_effect", "effect": "radial_stun", "field": "seconds", "by": 1 }
