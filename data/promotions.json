{
  "_설명": {
    "파일": "data/promotions.json",
    "하는 일": "전직 갈래 18개 (생존자 6명 × 3 — 직장인: 영업왕·야근왕·팀장). 레벨 10 에 1차(stage_1), 레벨 20 에 2차(stage_2) 가 적용된다. 능력치 바꾸기(add·multiply)와 스킬 바꾸기(skill_changes), 바뀐 옷 그림(outfit)을 정한다.",
    "쓰는 곳": "scripts/systems/promotion.gd 가 적용하고, scripts/ui/promotion_panel.gd 가 갈래 카드를 보여 준다.",
    "근거 문서": "02 §5 전직, 03 §1-2 전직 숫자, 04 §2 전직 옷차림"
  },
  "_스킬_바꾸기_종류": {
    "scale_effect": "효과 조각(effect)의 숫자(field)를 by 배로",
    "add_to_effect": "효과 조각의 숫자에 by 를 더함",
    "add_effect": "효과 조각(effect)을 하나 더함",
    "replace_skill": "스킬을 통째로 다른 스킬(skill)로",
    "scale_cooldown": "다시 쓰기 시간을 by 배로"
  },

  "police_swat": {
    "name": "특공대", "survivor": "police", "outfit": "police_swat",
    "summary": "섬광탄을 크게, 맞아도 버틴다",
