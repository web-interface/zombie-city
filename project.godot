; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
; 설정마다의 이유는 docs/07_기술구성.md 에 적는다 (Godot 이 저장할 때 이 파일의 주석을 지우기 때문).

config_version=5

[application]

config/name="좀비 도시 (가제)"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

GameData="*res://scripts/autoload/game_data.gd"
SceneRouter="*res://scripts/autoload/scene_router.gd"
SoundPlayer="*res://scripts/autoload/sound_player.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=180
window/size/viewport_height=320
window/size/window_width_override=360
window/size/window_height_override=640
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/handheld/orientation=1

[gui]

theme/custom="res://scenes/pixel_theme.tres"

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
